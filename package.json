{
  "name": "covertree",
  "displayName": "CoverTree",
  "description": "Jest code coverage indicators in the VS Code file explorer",
  "version": "0.1.0",
  "publisher": "mgrosshauser",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "jest",
    "coverage",
    "test",
    "typescript",
    "javascript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/WalSplitter/covertree-vscode"
  },
  "activationEvents": [
    "workspaceContains:**/jest.config.*",
    "workspaceContains:**/vitest.config.*",
    "workspaceContains:**/coverage/coverage-summary.json"
  ],
  "icon": "resources/icon.png",
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "covertree.coverageView",
          "name": "Coverage",
          "contextualTitle": "CoverTree"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "covertree.refresh",
          "when": "view == covertree.coverageView",
          "group": "navigation"
        }
      ]
    },
    "commands": [
      {
        "command": "covertree.refresh",
        "title": "CoverTree: Refresh Coverage",
        "icon": "$(refresh)"
      },
      {
        "command": "covertree.nextUncoveredLine",
        "title": "CoverTree: Go to Next Uncovered Line"
      },
      {
        "command": "covertree.prevUncoveredLine",
        "title": "CoverTree: Go to Previous Uncovered Line"
      }
    ],
    "keybindings": [
      {
        "command": "covertree.nextUncoveredLine",
        "key": "alt+shift+n",
        "when": "editorTextFocus"
      },
      {
        "command": "covertree.prevUncoveredLine",
        "key": "alt+shift+p",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "CoverTree",
      "properties": {
        "covertree.threshold": {
          "type": "number",
          "default": 75,
          "minimum": 0,
          "maximum": 100,
          "description": "Minimum coverage percentage to show passing indicator."
        },
        "covertree.coverageFile": {
          "type": "string",
          "default": "coverage/coverage-summary.json",
          "description": "Relative path to Jest coverage-summary.json from workspace root."
        },
        "covertree.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.ts",
            "**/*.tsx",
            "**/*.js",
            "**/*.jsx"
          ],
          "description": "Glob patterns of files to show coverage decorations on."
        },
        "covertree.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/out/**",
            "**/dist/**",
            "**/coverage/**"
          ],
          "description": "Glob patterns to exclude from coverage decorations."
        },
        "covertree.detailFile": {
          "type": "string",
          "default": "coverage/coverage-final.json",
          "description": "Relative path to Istanbul/Jest coverage-final.json used for editor gutter markers."
        },
        "covertree.showGutterMarkers": {
          "type": "boolean",
          "default": true,
          "description": "Show line-level coverage markers in the editor gutter."
        },
        "covertree.tool": {
          "type": "string",
          "enum": [
            "jest",
            "vitest",
            "nyc"
          ],
          "enumDescriptions": [
            "Jest (default)",
            "Vitest — compatible json-summary format",
            "NYC / Istanbul standalone"
          ],
          "default": "jest",
          "description": "Coverage tool used to generate the report. All tools produce compatible formats; this setting is informational and used for future tool-specific adjustments."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run compile",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.19.42",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
